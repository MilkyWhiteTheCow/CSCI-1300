#include <iostream>
#include <array>

using namespace std;



 void InitTransMatrix(double (&arr)[4][4], double Ps, double Pe, double Pi, double Pr)
    {
        transmatrix[1][1] = Ps;
        transmatrix[2][1] = 1 - Ps;
        for(int n = 1;n < 3; n++)
        {
            transmatrix[n+2][1] = 0;
        }

        transmatrix[1][2] = Pe;
        transmatrix[2][1] = 0;
        for(int n = 1;n < 3; n++)
        {
            transmatrix[n+2][2] = (1-Pe)/2;
        }

        for(int n = 1;n < 4; n++)
        {
            transmatrix[n][3] = 0;
        }
        transmatrix[4][3] = Pi;

        transmatrix[4][1] = 1 - Pr;
        for(int n = 1;n < 3; n++)
        {
            transmatrix[n+1][2] = 0;
        }
        transmatrix[4][4] = Pr;

    }

 void IterateStep(double reftransmmatrix& arr, double RefVec)
    {

    for(int i = 1; i < 5; i++)
    {

        int sum = 0;

        for(int j = 1; j < 5; j++)
        {
            sum += reftransmatrix[i][j] * RefVec[j];

        }

        RefVec[i] = sum;

    }

    }

     void InitRef();
    {
        for(int i = 1; i < 5; i++)
    {
        for(int j = 1; j < 5; j++)
        {
            reftransmatrix[i][j] = transmatrix[i, j];
        }
    }
    }




int main(){
    double transmatrix[4][4];
    double reftransmatrix[4][4];

    double InitialVec[4];
    double RefVec[4];

    double Ps, Pe, Pi, Pr;

    int iterations;

    
    cout << "What is Ps?" << endl;
