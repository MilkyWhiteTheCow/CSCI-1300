#include<iostream>

using namespace std;

int main()
{
    int floor, actualFloor;
    cout << "Floor: ";
    cin >> floor;

    if (floor > 13) 
    {
        actualFloor = floor - 1;




    }
    else 
    {
        actualFloor = floor;



    }

    cout << "The actual floor is floor" << actualFloor << "." << endl;

    return(0);



}

//Option for short cut: define actual floor as floor before the if else statement. this way you don't have to use the else component
